# Лог локальных прогонов. В GitHub Actions вывод виден прямо в логе задачи,
# поэтому в репозитории он только создавал бы шум в коммитах.
Оповещения.log

# Резервные копии из ручных экспериментов
*.bak

# Секреты рядом с кодом держать нельзя: репозиторий публичный,
# а git add -A подхватывает всё подряд
Токен*
*token*
*.pem
*.key
